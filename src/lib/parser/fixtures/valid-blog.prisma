generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  USER
  ADMIN
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  displayName String?
  role        Role    @default(USER)
  posts       Post[]
}

model Post {
  id        Int      @id
  title     String
  published Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tags      String[]
  metadata  Json?
}
